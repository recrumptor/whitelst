mode: rule
# Proxy Mode: TPROXY
tproxy-port: 7894
ipv6: true
log-level: error
allow-lan: false
port: 
mixed-port: 10801
unified-delay: true
tcp-concurrent: true
external-controller: 192.168.1.1:9090
external-ui: ./ui
external-ui-url: "https://github.com/Zephyruso/zashboard/releases/latest/download/dist-cdn-fonts.zip"

dns:
  enable: true
  listen: 0.0.0.0:7874
  ipv6: true
    
  default-nameserver:
    #- 77.88.8.8
    #- 77.88.8.1
    - 80.71.208.214
    - 83.136.112.246
  nameserver:
    - https://cloudflare-dns.com/dns-query
    #- https://dns.google/dns-query
    #- https://common.dot.dns.yandex.net/dns-query
     
  nameserver-policy:
       
    #'rule-set:geo-blocked': 'https://1.1.1.1/dns-query#disable-ipv6=true' # оставляем только ipv4 там где это нужно 
    #'rule-set:gemini': 'https://1.1.1.1/dns-query#disable-ipv6=true'
    'rule-set:geo-blocked': '10.2.0.1#PROXY&disable-ipv6=true'
    'rule-set:gemini': '10.2.0.1#PROXY&disable-ipv6=true'
    #'rule-set:gemini': 'https://dns.comss.one/dns-query#disable-ipv6=true' # костыль если gemini не работает
keep-alive-idle: 120
keep-alive-interval: 60
find-process-mode: off

profile:
  store-selected: true
  
routing-mark: 2

sniffer:
  enable: false
  force-dns-mapping: true
  parse-pure-ip: true
  sniff:
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    TLS:
      ports: [443, 8443]
    #QUIC:
      #ports: [443, 8443]
      
  skip-domain:
    - "Mijia Cloud"
    - '+.lan'
    - '+.local'
    - '+.push.apple.com'
    - '+.apple.com'
  
proxies:
  
  - name: 🇷🇺 WARP
    type: direct # выносим вайрегард-соединения из clash для нативной обработки ядром системы
    interface-name: awg1
      
  - name: 🇳🇱 Proton
    type: direct # цепочку прокси в данном случае сделал через системный  Routing=> Static IPv4 Routes 
    interface-name: proton
      
proxy-groups:
    
  - name: PROXY
    type: select
    proxies:
    - 🇳🇱 Proton
    
  - name: WARP
    type: select
    proxies:
    - 🇷🇺 WARP
    
rule-providers:

  mybest_ads:
    behavior: domain
    type: http
    format: mrs
    url: 'https://github.com/recrumptor/whitelst/releases/download/latest/category-ads-all.mrs'
    path: ./ruleset/my-ads.mrs
    interval: 86400
    
  geo-blocked:
    behavior: domain
    type: http
    format: mrs
    url: 'https://github.com/itdoginfo/allow-domains/releases/latest/download/geoblock_domain.mrs'
    interval: 86400
    path: ./ruleset/geo-blocked.mrs
    
  gemini:
    behavior: domain
    type: http
    format: mrs
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/refs/heads/meta/geo/geosite/google-gemini.mrs"
    interval: 86400
    path: ./ruleset/gemini.mrs
  
  #youtube:
    #behavior: domain
    #type: http
    #format: mrs
    #url: "https://github.com/itdoginfo/allow-domains/releases/latest/download/youtube_domain.mrs"
    #interval: 86400
    #path: ./ruleset/youtube.mrs
    
  telegram:
    behavior: domain
    type: http
    format: mrs
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/refs/heads/meta/geo/geosite/telegram.mrs"
    interval: 86400
    path: ./ruleset/telegram.mrs
    
  telegram-ip:
    behavior: ipcidr
    type: http
    format: mrs
    #url: https://core.telegram.org/resources/cidr.txt
    url: "https://github.com/MetaCubeX/meta-rules-dat/raw/refs/heads/meta/geo/geoip/telegram.mrs"
    interval: 86400
    path: ./ruleset/telegram-ip.mrs
rules:
  
  - RULE-SET,mybest_ads,REJECT
  - DOMAIN-SUFFIX,vigo.one,REJECT
  - DOMAIN-SUFFIX,uxfeedback.ru,REJECT
  - DOMAIN-SUFFIX,protonvpn.com,WARP
  - DOMAIN-SUFFIX,cloudfront.net,PROXY
  - RULE-SET,telegram,PROXY
  - RULE-SET,telegram-ip,PROXY,no-resolve
  - RULE-SET,gemini,PROXY
  - RULE-SET,geo-blocked,PROXY
  - MATCH,DIRECT
