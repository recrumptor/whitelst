mode: rule
# Proxy Mode: TPROXY
tproxy-port: 7894
ipv6: true
log-level: error
allow-lan: false
port: 
mixed-port: 10801
unified-delay: true
tcp-concurrent: true
external-controller: 192.168.1.1:9090
external-ui: ./ui
external-ui-url: "https://github.com/Zephyruso/zashboard/releases/latest/download/dist-cdn-fonts.zip"

dns:
  enable: true
  listen: 0.0.0.0:7874
  ipv6: true
    
  default-nameserver:
    #- 77.88.8.8
    #- 77.88.8.1
    - 80.71.208.214
    - 83.136.112.246
  nameserver:
    - https://cloudflare-dns.com/dns-query
    #- https://dns.google/dns-query
    #- https://common.dot.dns.yandex.net/dns-query
     
  nameserver-policy:
       
    #'rule-set:geo-blocked': 'https://1.1.1.1/dns-query#disable-ipv6=true' # оставляем только ipv4 там где это нужно 
    #'rule-set:gemini': 'https://1.1.1.1/dns-query#disable-ipv6=true'
    'rule-set:geo-blocked': '10.2.0.1#PROXY&disable-ipv6=true'
    'rule-set:gemini': '10.2.0.1#PROXY&disable-ipv6=true'

keep-alive-idle: 120
keep-alive-interval: 60
find-process-mode: off

profile:
  store-selected: true
  
routing-mark: 2

sniffer:
  enable: false
  force-dns-mapping: true
  parse-pure-ip: true
  sniff:
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    TLS:
      ports: [443, 8443]
    #QUIC:
      #ports: [443, 8443]
      
  skip-domain:
    - "Mijia Cloud"
    - '+.lan'
    - '+.local'
    - '+.push.apple.com'
    - '+.apple.com'
  
proxies:
  
  - name: 🇷🇺 WARP
    type: direct # выносим вайрегард-соединения из clash для нативной обработки ядром системы
    interface-name: awg1
      
  - name: 🇳🇱 Proton
    type: direct # цепочку прокси в данном случае сделал через системный  Routing=> Static IPv4 Routes 
    interface-name: proton
      
proxy-groups:
    
  - name: PROXY
    type: select
    proxies:
    - 🇳🇱 Proton
    
  - name: WARP
    type: select
    proxies:
    - 🇷🇺 WARP
    
rule-providers:

  awavenue_ads:
    type: http
    behavior: classical
    url: "https://raw.githubusercontent.com/TG-Twilight/AWAvenue-Ads-Rule/main/Filters/AWAvenue-Ads-Rule-Clash-Classical.yaml"
    path: ./ruleset/awavenue.yaml
    interval: 86400
    
  geo-blocked:
    behavior: domain
    type: http
    format: text
    url: 'https://raw.githubusercontent.com/recrumptor/whitelst/refs/heads/main/geo.txt'
    interval: 86400
    path: ./ruleset/geo-blocked.yaml
    
  gemini:
    behavior: domain
    type: http
    format: text
    url: "https://raw.githubusercontent.com/recrumptor/whitelst/refs/heads/main/GoogleAI.txt"
    interval: 86400
    path: ./ruleset/gemini.yaml
  
  youtube:
    behavior: domain
    type: http
    format: text
    url: "https://raw.githubusercontent.com/recrumptor/whitelst/refs/heads/main/Youtube.txt"
    interval: 86400
    path: ./ruleset/youtube.yaml
    
  telegram:
    behavior: domain
    type: http
    format: text
    url: "https://raw.githubusercontent.com/recrumptor/whitelst/refs/heads/main/telegram.txt"
    interval: 86400
    path: ./ruleset/telegram.yaml
    
  telegram-ip:
    behavior: ipcidr
    type: http
    format: text
    url: https://core.telegram.org/resources/cidr.txt
    interval: 86400
    path: ./ruleset/telegram-ip.yaml

rules:
  
  - DOMAIN,adsdk.yandex.ru,REJECT
  - DOMAIN,ad.mail.ru,REJECT
  - RULE-SET,awavenue_ads,REJECT
  - DOMAIN-SUFFIX,vigo.one,REJECT
  - DOMAIN-SUFFIX,uxfeedback.ru,REJECT
  - DOMAIN-SUFFIX,tns-counter.ru,REJECT
  - DOMAIN-KEYWORD,2ip,PROXY
  - DOMAIN-SUFFIX,protonvpn.com,WARP
  - DOMAIN-SUFFIX,cloudfront.net,PROXY
  - RULE-SET,telegram,PROXY
  - RULE-SET,telegram-ip,PROXY,no-resolve
  - RULE-SET,gemini,PROXY
  - RULE-SET,geo-blocked,PROXY
  - MATCH,DIRECT
